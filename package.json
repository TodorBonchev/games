{
  "name": "games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two browser experiences: a zombie survival world with 30 discoverable native activities, and a piano.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:mobile:hud": "node tests/mobile-hud-browser.mjs",
    "test:mobile:movement": "node tests/touch-movement-browser.mjs",
    "test:abilities": "node tests/abilities-browser.mjs",
    "test:garden": "node tests/activities-browser.mjs --activity=garden",
    "test:phone": "node tests/activities-browser.mjs --phone-only",
    "test:campaign": "node tests/activities-browser.mjs",
    "test:saves": "node tests/activities-browser.mjs",
    "test:borrowed": "node tests/activities-browser.mjs --activity=borrowed",
    "test:moonbounce": "node tests/activities-browser.mjs --activity=moonbounce",
    "test:popwake": "node tests/activities-browser.mjs --activity=popwake",
    "test:pondpost": "node tests/activities-browser.mjs --activity=pondpost",
    "test:prism": "node tests/activities-browser.mjs --activity=prism",
    "test:ribbon": "node tests/activities-browser.mjs --activity=ribbon",
    "test:dewfall": "node tests/activities-browser.mjs --activity=dewfall",
    "test:lantern": "node tests/activities-browser.mjs --activity=lantern",
    "test:collection": "node tests/activities-browser.mjs",
    "test:arcade": "node tests/activities-browser.mjs --group=arcade",
    "test:arcade:action": "node tests/activities-browser.mjs --group=arcade",
    "test:arcade:puzzles": "node tests/activities-browser.mjs --group=arcade",
    "test:arcade:skill": "node tests/activities-browser.mjs --group=arcade",
    "test:voyage": "node tests/activities-browser.mjs",
    "test:voyage:legacy": "node tests/activities-browser.mjs --group=legacy",
    "test:voyage:wins": "node tests/activities-browser.mjs",
    "test:lantern:space": "node tests/activities-browser.mjs --activity=lantern",
    "test:upside": "node tests/activities-browser.mjs --activity=upside",
    "test:piano": "node tests/piano-wait-browser.mjs",
    "test:piano:hands": "node tests/piano-hands-browser.mjs",
    "test:lantern:expedition": "node tests/activities-browser.mjs --activity=lantern",
    "test:upside:quality": "node tests/activities-browser.mjs --activity=upside",
    "test:activities": "node tests/activities-browser.mjs",
    "test:polish": "node tests/activity-polish-browser.mjs",
    "test:survival:polish": "node tests/survival-polish-browser.mjs",
    "test:survival:combat": "node tests/survival-combat-browser.mjs",
    "test:survival:settings": "node tests/survival-settings-browser.mjs",
    "test:survival:support": "node tests/survival-support-browser.mjs",
    "test:outposts": "node tests/activity-directory-browser.mjs",
    "test:survival:50": "node tests/survival-combat-browser.mjs && node tests/survival-settings-browser.mjs && node tests/survival-support-browser.mjs && node tests/activity-directory-browser.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "playwright": "1.63.0"
  }
}
