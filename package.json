{
  "name": "games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Six Three.js browser games, including Wonderwake: a connected 25-challenge island adventure.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:abilities": "node tests/abilities-browser.mjs",
    "test:garden": "node tests/garden-browser.mjs",
    "test:phone": "node tests/garden-browser.mjs --phone-only",
    "test:campaign": "node tests/garden-browser.mjs --campaign-only",
    "test:saves": "node tests/garden-browser.mjs --saves-only",
    "test:borrowed": "node tests/borrowed-browser.mjs",
    "test:moonbounce": "node tests/moonbounce-browser.mjs",
    "test:popwake": "node tests/popwake-browser.mjs",
    "test:pondpost": "node tests/pondpost-browser.mjs",
    "test:prism": "node tests/prism-browser.mjs",
    "test:ribbon": "node tests/ribbon-browser.mjs",
    "test:dewfall": "node tests/dewfall-browser.mjs",
    "test:lantern": "node tests/lantern-browser.mjs",
    "test:collection": "node tests/collection-browser.mjs",
    "test:arcade": "node tests/arcade-browser.mjs",
    "test:arcade:action": "node tests/arcade-action-browser.mjs",
    "test:arcade:puzzles": "node tests/arcade-puzzle-browser.mjs",
    "test:arcade:skill": "node tests/arcade-skill-browser.mjs",
    "test:voyage": "node tests/voyage-browser.mjs",
    "test:voyage:legacy": "node tests/voyage-legacy-browser.mjs",
    "test:voyage:wins": "node tests/voyage-arcade-wins-browser.mjs",
    "test:lantern:space": "node tests/lantern-space-browser.mjs",
    "test:piano": "node tests/piano-wait-browser.mjs",
    "test:lantern:expedition": "node tests/lantern-expedition-browser.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "playwright": "1.63.0"
  }
}
